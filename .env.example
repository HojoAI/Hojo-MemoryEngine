# Copy to .env and set your own infrastructure credentials.
APP_DISABLE_AUTH=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=memory_engine
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=memory_engine
REDIS_URL=redis://127.0.0.1:6379
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Migration and privacy controls.
MEMORY_V1_DUAL_WRITE_ENABLED=false
MEMORY_RUNTIME_MONITOR_ENABLED=false
MEMORY_RETRIEVE_DIAGNOSTICS_ENABLED=false
